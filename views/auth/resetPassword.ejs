<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Create a new TechNova account password.">
    <title>Reset Password | TechNova</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/auth-recovery.css">
</head>
<body>
    <main class="recovery-shell">
        <header class="recovery-header">
            <a class="brand" href="/" aria-label="TechNova home">
                <% if (siteSettings?.brandLogo) { %>
                    <img class="auth-brand-logo" src="<%= uploadUrl(siteSettings.brandLogo) %>" alt="TechNova logo">
                <% } else { %>
                    <span class="brand-mark">TN</span>
                <% } %>
                <span class="brand-name">TECHNOVA</span>
            </a>
            <a class="back-link" href="/login">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                Back to sign in
            </a>
        </header>

        <section class="recovery-card" aria-labelledby="reset-title">
            <div class="recovery-icon" aria-hidden="true">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <span class="eyebrow">Secure update</span>
            <h1 id="reset-title">Create a new password</h1>
            <p class="recovery-intro">Choose a strong password you have not used on another account.</p>

            <form action="/reset-password/<%= token %>" method="POST" class="recovery-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="field-group">
                    <label for="password">New password</label>
                    <div class="password-field">
                        <input type="password" id="password" name="password" placeholder="Enter a new password" autocomplete="new-password" required minlength="6">
                        <button type="button" class="password-toggle" data-password-toggle="password" aria-label="Show password" aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="field-group">
                    <label for="confirmPassword">Confirm new password</label>
                    <div class="password-field">
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat your new password" autocomplete="new-password" required minlength="6">
                        <button type="button" class="password-toggle" data-password-toggle="confirmPassword" aria-label="Show password" aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="recovery-button">
                    Update password
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                </button>
            </form>

            <p class="recovery-footer"><a href="/login">Return to sign in</a></p>
        </section>
    </main>
    <script src="/js/password-toggle.js?v=2"></script>
</body>
</html>