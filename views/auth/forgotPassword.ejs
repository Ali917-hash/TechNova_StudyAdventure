<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Reset your TechNova learning account password.">
    <title>Forgot Password | TechNova</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/css/auth-recovery.css">
</head>
<body>
    <main class="recovery-shell">
        <header class="recovery-header">
            <a class="brand" href="/" aria-label="TechNova home">
                <span class="brand-mark">TN</span>
                <span class="brand-name">TECHNOVA</span>
            </a>
            <a class="back-link" href="/login">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                Back to sign in
            </a>
        </header>

        <section class="recovery-card" aria-labelledby="forgot-title">
            <div class="recovery-icon" aria-hidden="true">
                <i class="fa-solid fa-key"></i>
            </div>
            <span class="eyebrow">Account recovery</span>
            <h1 id="forgot-title">Forgot your password?</h1>
            <p class="recovery-intro">Enter the email address linked to your account and we will send you a secure reset link.</p>

            <% if (locals.success) { %>
                <div class="success-message" role="status">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <form action="/forgot-password" method="POST" class="recovery-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="field-group">
                    <label for="email">Email address</label>
                    <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>
                </div>
                <button type="submit" class="recovery-button">
                    Send reset link
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <p class="recovery-footer"><a href="/login">Return to sign in</a></p>
        </section>
    </main>
</body>
</html>