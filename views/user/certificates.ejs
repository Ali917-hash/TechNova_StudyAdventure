<%
const currentPage = "certificates";
%>

<%- include("../layouts/userDashboardHeader") %>

<%- include("../partials/dashboardSidebar", {
    currentPage: "certificates"
}) %>


<div class="main-content">

    <!-- Page Header -->

    <div class="page-header">

        <h1>
            My Certificates
        </h1>

        <p>
            View your completed course certificates.
        </p>

    </div>


    <% if (certificates.length === 0) { %>

        <!-- Empty State -->

        <div class="certificate-empty">

            <div class="empty-icon">

                <i class="fa-solid fa-certificate"></i>

            </div>

            <h2>
                No Certificates Yet
            </h2>

            <p>
                Complete a course to earn your certificate.
            </p>

            <a
                href="/services"
                class="browse-courses-btn">

                Browse Courses

            </a>

        </div>


    <% } else { %>


        <!-- Certificates -->

        <div class="certificates-grid">

            <% certificates.forEach(certificate => { %>


                <div class="certificate-card">

                    <div class="certificate-icon">

                        <i class="fa-solid fa-certificate"></i>

                    </div>


                    <div class="certificate-content">

                        <h2>
                            <%= certificate.course.title %>
                        </h2>


                        <p class="certificate-label">
                            Certificate of Completion
                        </p>


                        <p class="certificate-id">

                            Certificate ID:

                            <strong>
                                <%= certificate.certificateId %>
                            </strong>

                        </p>


                        <p class="certificate-date">

                            Issued:

                            <%= new Date(
                                certificate.issuedAt
                            ).toLocaleDateString() %>

                        </p>


                        <div class="certificate-actions">

                            <a
                                href="/certificates/<%= certificate._id %>"
                                class="view-certificate-btn">

                                <i class="fa-solid fa-eye"></i>

                                View Certificate

                            </a>

                        </div>

                    </div>

                </div>


            <% }) %>

        </div>


    <% } %>

</div>


<%- include("../layouts/dashboardFooter") %>