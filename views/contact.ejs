<%- include("layouts/header") %>

<!-- =====================================================
     CONTACT HERO
====================================================== -->

<%
const hero =
    siteSettings?.heroes?.contact || {};
%>


<section
    class="hero contact-hero"
    id="home"
>


    <div class="container hero-inner">


        <div class="contact-hero-text">


            <% if (hero.badge) { %>

                <span class="hero-label">

                    <%= hero.badge %>

                </span>

            <% } %>


            <h1>

                <%= hero.title ||
                    "Let's Build"
                %>

                <br>

                <span>

                    <%= hero.highlight ||
                        "Something Great Together"
                    %>

                </span>

            </h1>


            <p>

                <%= hero.description ||
                    "Ready to start your next project? Tell us about your vision and we'll help you build a modern solution that scales."
                %>

            </p>


            <div class="hero-cta">


                <a
                    class="cta-btn"
                    href="<%= hero.buttonLink || '#contact-form' %>"
                >

                    <%= hero.buttonText ||
                        "Send a Message"
                    %>

                    <i
                        class="fa-solid fa-arrow-down"
                    ></i>

                </a>


            </div>


        </div>


        <% if (hero.image) { %>

            <div
                class="contact-hero-visual has-image"
                style="
                    background-image:
                    url('/uploads/<%= hero.image %>');
                "
            ></div>

        <% } else { %>

            <div class="contact-hero-visual">

                <div class="contact-hero-circle"></div>


                <div class="contact-hero-card">

                    <i
                        class="fa-solid fa-headset"
                    ></i>


                    <strong>
                        TechNova Support
                    </strong>


                    <span>
                        We're here to help
                    </span>

                </div>

            </div>

        <% } %>


    </div>

</section>


<!-- =====================================================
     SUCCESS MESSAGE
====================================================== -->

<% if (querySuccess) { %>

    <div class="contact-success-message">

        <div class="contact-success-icon">

            <i
                class="fa-solid fa-circle-check"
            ></i>

        </div>


        <div>

            <strong>
                Message Sent Successfully
            </strong>

            <p>
                Thank you for contacting TechNova.
                Our team will get back to you soon.
            </p>

        </div>

    </div>

<% } %>



<!-- =====================================================
     CONTACT MAIN SECTION
====================================================== -->

<section class="contact-section">

    <div class="container contact-layout">


        <!-- ==========================================
             CONTACT FORM
        =========================================== -->

        <div
            class="contact-form-container"
            id="contact-form"
        >


            <div class="contact-card-header">

                <span class="section-label">
                    SEND A MESSAGE
                </span>


                <h2>
                    Let's Talk
                </h2>


                <p>
                    Complete the form below and our team
                    will contact you as soon as possible.
                </p>

            </div>



            <!-- IMPORTANT:
                 Existing contact form functionality
                 remains unchanged.
            -->

            <form
                id="contactForm"
                action="/contact"
                method="POST"
            >

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >


                <!-- NAME -->

                <div class="form-group">

                    <label for="name">
                        Full Name
                    </label>


                    <div class="contact-input-wrapper">

                        <i
                            class="fa-solid fa-user"
                        ></i>


                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= user ? `${user.firstName || ''} ${user.lastName || ''}`.trim() : '' %>"
                            placeholder="Ali Raza"
                            required
                        >

                    </div>

                </div>



                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email">
                        Email Address
                    </label>


                    <div class="contact-input-wrapper">

                        <i
                            class="fa-solid fa-envelope"
                        ></i>


                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= user ? user.email : '' %>"
                            placeholder="ali@example.com"
                            required
                        >

                    </div>

                </div>



                <!-- PHONE -->

                <div class="form-group">

                    <label for="phone">
                        Phone Number
                    </label>


                    <div class="contact-input-wrapper">

                        <i
                            class="fa-solid fa-phone"
                        ></i>


                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="+92 300 0000000"
                        >

                    </div>

                </div>



                <!-- SUBJECT -->

                <div class="form-group">

                    <label for="subject">
                        Subject
                    </label>


                    <div class="contact-input-wrapper">

                        <i
                            class="fa-solid fa-list"
                        ></i>


                        <select
                            id="subject"
                            name="subject"
                            title="Subject"
                            required
                        >

                            <option
                                value=""
                                disabled
                                selected
                            >

                                Select a subject

                            </option>


                            <option value="Technical Support">
                                Technical Support
                            </option>


                            <option value="Course Inquiry">
                                Course Inquiry
                            </option>


                            <option value="Partnership">
                                Partnership
                            </option>


                            <option value="Enrollment">
                                Enrollment
                            </option>


                            <option value="Portfolio">
                                Portfolio
                            </option>


                            <option value="Website Services">
                                Website Services
                            </option>


                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>

                </div>



                <!-- MESSAGE -->

                <div class="form-group">

                    <label for="message">
                        Message
                    </label>


                    <div class="contact-textarea-wrapper">

                        <i
                            class="fa-solid fa-message"
                        ></i>


                        <textarea
                            id="message"
                            name="message"
                            rows="6"
                            placeholder="Tell us more about your requirements..."
                            required
                        ></textarea>

                    </div>

                </div>



                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="send-btn"
                >

                    <i
                        class="fa-solid fa-paper-plane"
                    ></i>

                    Send Message

                </button>


            </form>

        </div>



        <!-- ==========================================
             CONTACT INFORMATION
        =========================================== -->

        <div class="contact-info-container">


            <div class="contact-card-header">

                <span class="section-label">
                    CONTACT INFORMATION
                </span>


                <h2>
                    How Can We Help?
                </h2>


                <p>
                    Reach out to us using any of the
                    contact methods below.
                </p>

            </div>



            <!-- ADDRESS -->

            <div class="info-item">

                <div class="icon">

                    <i
                        class="fa-solid fa-location-dot"
                    ></i>

                </div>


                <div class="text">

                    <strong>
                        Address
                    </strong>


                    <p>
                        <%= siteSettings.contactAddress || "" %>
                    </p>

                </div>

            </div>



            <!-- PHONE -->

            <div class="info-item">

                <div class="icon">

                    <i
                        class="fa-solid fa-phone"
                    ></i>

                </div>


                <div class="text">

                    <strong>
                        Phone
                    </strong>


                    <p>
                        <%= siteSettings.contactPhone || "" %>
                    </p>

                </div>

            </div>



            <!-- EMAIL -->

            <div class="info-item">

                <div class="icon">

                    <i
                        class="fa-solid fa-envelope"
                    ></i>

                </div>


                <div class="text">

                    <strong>
                        Email
                    </strong>


                    <p>
                        <%= siteSettings.contactEmail || "" %>
                    </p>

                </div>

            </div>



            <!-- HOURS -->

            <div class="info-item">

                <div class="icon">

                    <i
                        class="fa-solid fa-clock"
                    ></i>

                </div>


                <div class="text">

                    <strong>
                        Business Hours
                    </strong>


                    <p>
                        <%= siteSettings.contactHours || "" %>
                    </p>

                </div>

            </div>



            <!-- SUPPORT CARD -->

            <div class="support-card">

                <div class="support-icon">

                    <i
                        class="fa-solid fa-headset"
                    ></i>

                </div>


                <div>

                    <strong>
                        Need Immediate Help?
                    </strong>


                    <p>
                        Our support team is ready to
                        help with your questions.
                    </p>

                </div>

            </div>


        </div>

    </div>

</section>



<!-- =====================================================
     FAQ
====================================================== -->

<div class="faq-container">

    <%
        const contactFaqs =
            (siteSettings.contactFaqs || [])
                .filter(faq => faq.visible !== false)
                .sort((a, b) => a.order - b.order);
    %>


    <% if (contactFaqs.length > 0) { %>


        <% contactFaqs.forEach(
            (faq, index) => {
        %>


            <div
                class="faq-card"
                data-faq="<%= index %>"
            >

                <button
                    type="button"
                    class="faq-question"
                >

                    <span>
                        <%= faq.question %>
                    </span>


                    <i
                        class="fa-solid fa-chevron-down"
                    ></i>

                </button>


                <div class="faq-answer">

                    <p>
                        <%= faq.answer %>
                    </p>

                </div>

            </div>


        <% }) %>


    <% } else { %>


        <div class="faq-empty">

            <i
                class="fa-solid fa-circle-question"
            ></i>

            <p>
                No FAQs are currently available.
            </p>

        </div>


    <% } %>

</div>


<%- include("layouts/footer") %>



<script nonce="<%= cspNonce %>">

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            const faqCards =
                document.querySelectorAll(
                    ".faq-card"
                );


            faqCards.forEach(
                function (card) {


                    const question =
                        card.querySelector(
                            ".faq-question"
                        );


                    question.addEventListener(
                        "click",
                        function () {


                            faqCards.forEach(
                                function (otherCard) {

                                    if (
                                        otherCard !== card
                                    ) {

                                        otherCard.classList.remove(
                                            "active"
                                        );

                                    }

                                }
                            );


                            card.classList.toggle(
                                "active"
                            );

                        }
                    );

                }
            );

        }
    );

</script>