<%
const currentPage = "courses";
%>

<%- include("../layouts/adminDashboardHeader") %>

<%- include("../partials/adminSidebar") %>


<div class="dashboard">

    <div class="main-content">

        <div class="page-header">

            <div>
                <h1>All Courses</h1>
                <p>Manage your available courses.</p>
            </div>

            <a
                href="/admin/course/add"
                class="add-course-btn"
                title="Add a new course">
                <i class="fa-solid fa-plus"></i>
                Add Course
            </a>

        </div>

        <table class="course-table">

            <thead>

                <tr>

                    <th>#</th>

                    <th>Image</th>

                    <th>Title</th>

                    <th>Instructor</th>

                    <th>Category</th>

                    <th>Price</th>

                    <th>Level</th>

                    <th>Duration</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <% if(courses.length===0){ %>

                    <tr>

                        <td colspan="9" style="text-align:center">

                            No Course Found

                        </td>

                    </tr>

                <% } %>

                <% courses.forEach((course,index)=>{ %>

                    <tr>

                        <td><%= index+1 %></td>

                        <td> <img src="/uploads/<%= course.image %>"
                            width="120"
                            height="80"
                            style="object-fit:contain;border-radius:6px;">
                        </td>

                        <td><%= course.title %></td>

                        <td><%= course.instructor %></td>

                        <td><%= course.category %></td>

                        <td>Rs. <%= course.price %></td>

                        <td><%= course.level %></td>

                        <td><%= course.duration %></td>

                        <td>
                            <a
                                href="/admin/course/edit/<%= course._id %>"
                                class="edit-btn"> Edit
                            </a>

                            <form
                                action="/admin/course/delete/<%= course._id %>"
                                method="POST"
                                style="display:inline;"
                                data-confirm="Are you sure you want to delete this course?"
                            >
                                <input
                                    type="hidden"
                                    name="_csrf"
                                    value="<%= csrfToken %>"
                                >

                                <button
                                    type="submit"
                                    class="delete-btn"
                                    title="Delete Course"
                                >
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

<%- include("../layouts/dashboardFooter") %>