<%
const currentPage = "blogs";
%>

<%- include("../layouts/adminDashboardHeader") %>

<%- include("../partials/adminSidebar") %>


<div class="main-content">


    <div class="admin-page-header">

        <div>

            <h1>
                Edit Blog
            </h1>

            <p>
                Update your TechNova blog post.
            </p>

        </div>


        <a
            href="/admin/blogs"
            class="back-btn"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Back to Blogs

        </a>

    </div>



    <div class="form-container">


        <form
            action="/admin/blog/update/<%= blog._id %>"
            method="POST"
            enctype="multipart/form-data"
        >

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">


            <div class="form-group">

                <label>
                    Blog Title
                </label>

                <input
                    type="text"
                    name="title"
                    value="<%= blog.title %>"
                    required
                >

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        Category
                    </label>

                    <input
                        type="text"
                        name="category"
                        value="<%= blog.category %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Author
                    </label>

                    <input
                        type="text"
                        name="author"
                        value="<%= blog.author %>"
                        required
                    >

                </div>

            </div>


            <div class="form-group">

                <label>
                    Current Image
                </label>

                <div
                    style="
                        margin-bottom:15px;
                        padding:15px;
                        background:#f8fafc;
                        border-radius:10px;
                    "
                >

                    <img
                        src="<%= uploadUrl(blog.image) %>"
                        alt="<%= blog.title %>"
                        style="
                            width:220px;
                            max-width:100%;
                            height:120px;
                            object-fit:cover;
                            border-radius:8px;
                        "
                    >

                </div>


                <label>
                    Replace Image
                </label>

                <input
                    type="file"
                    name="image"
                    accept=".jpg,.jpeg,.png,.webp"
                >

            </div>


            <div class="form-group">

                <label>
                    Short Excerpt
                </label>

                <textarea
                    name="excerpt"
                    rows="4"
                    maxlength="500"
                    required
                ><%= blog.excerpt %></textarea>

            </div>


            <div class="form-group">

                <label>
                    Full Content
                </label>

                <textarea
                    name="content"
                    rows="14"
                    required
                ><%= blog.content %></textarea>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>
                        Publishing
                    </label>

                    <select
                        name="isPublished"
                    >

                        <option
                            value="true"
                            <%= blog.isPublished ? "selected" : "" %>
                        >
                            Published
                        </option>

                        <option
                            value="false"
                            <%= !blog.isPublished ? "selected" : "" %>
                        >
                            Draft
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Featured
                    </label>

                    <select
                        name="isFeatured"
                    >

                        <option
                            value="true"
                            <%= blog.isFeatured ? "selected" : "" %>
                        >
                            Yes
                        </option>

                        <option
                            value="false"
                            <%= !blog.isFeatured ? "selected" : "" %>
                        >
                            No
                        </option>

                    </select>

                </div>

            </div>


            <button
                type="submit"
                class="save-btn"
            >

                <i class="fa-solid fa-floppy-disk"></i>

                Update Blog

            </button>

        </form>

    </div>

</div>


<%- include("../layouts/dashboardFooter") %>