<%- include("../layouts/adminDashboardHeader") %>


<div class="dashboard">


    <%- include("../partials/adminSidebar") %>


    <div class="main-content">


        <div class="page-header">

            <h1>
                Edit Course
            </h1>

            <p>
                Update course information and course learning material.
            </p>

        </div>


        <div class="form-container">


            <form
                action="/admin/course/update/<%= course._id %>"
                method="POST"
                enctype="multipart/form-data"
            >

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>">


                <!-- ==========================================
                     COURSE TITLE
                =========================================== -->

                <div class="form-group">

                    <label>
                        Course Title
                    </label>

                    <input
                        type="text"
                        name="title"
                        value="<%= course.title %>"
                        required
                    >

                </div>


                <!-- ==========================================
                     INSTRUCTOR
                =========================================== -->

                <div class="form-group">

                    <label>
                        Instructor
                    </label>

                    <input
                        type="text"
                        name="instructor"
                        value="<%= course.instructor %>"
                        required
                    >

                </div>


                <!-- ==========================================
                     CATEGORY
                =========================================== -->

                <div class="form-group">

                    <label>
                        Category
                    </label>

                    <input
                        type="text"
                        name="category"
                        value="<%= course.category %>"
                        required
                    >

                </div>


                <!-- ==========================================
                     PRICE + DURATION
                =========================================== -->

                <div class="form-row">


                    <div class="form-group">

                        <label>
                            Price
                        </label>

                        <input
                            type="number"
                            name="price"
                            value="<%= course.price %>"
                        >

                    </div>


                    <div class="form-group">

                        <label>
                            Duration
                        </label>

                        <input
                            type="text"
                            name="duration"
                            value="<%= course.duration %>"
                        >

                    </div>


                </div>


                <!-- ==========================================
                     LEVEL
                =========================================== -->

                <div class="form-group">

                    <label>
                        Level
                    </label>

                    <input
                        type="text"
                        name="level"
                        value="<%= course.level %>"
                    >

                </div>


                <!-- ==========================================
                     DESCRIPTION
                =========================================== -->

                <div class="form-group">

                    <label>
                        Description
                    </label>

                    <textarea
                        name="description"
                        rows="6"
                    ><%= course.description %></textarea>

                </div>


                <!-- ==========================================
                     COURSE THUMBNAIL
                =========================================== -->

                <div class="form-group">

                    <label for="image">
                        Course Thumbnail
                    </label>

                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept=".jpg,.jpeg,.png,.webp"
                    >

                    <% if (course.image) { %>

                        <small
                            style="
                                display:block;
                                margin-top:8px;
                                color:#64748b;
                            "
                        >

                            Current thumbnail:

                            <strong>
                                <%= course.image %>
                            </strong>

                        </small>

                    <% } %>

                </div>


                <!-- ==========================================
                     COURSE LEARNING MATERIAL
                =========================================== -->

                <div class="form-group">

                    <label for="contentFolder">

                        Course Learning Material

                    </label>


                    <!-- CURRENT MATERIAL INFORMATION -->

                    <% if (
                        course.contentFiles &&
                        course.contentFiles.length > 0
                    ) { %>


                        <div
                            class="current-course-material"
                            style="
                                margin-bottom:15px;
                                padding:18px;
                                background:#f8fafc;
                                border:1px solid #e2e8f0;
                                border-radius:10px;
                            "
                        >

                            <div
                                style="
                                    display:flex;
                                    justify-content:space-between;
                                    align-items:center;
                                    gap:15px;
                                    margin-bottom:12px;
                                "
                            >

                                <strong>
                                    Current Course Material
                                </strong>


                                <span
                                    style="
                                        padding:5px 10px;
                                        background:#dbeafe;
                                        color:#1d4ed8;
                                        border-radius:20px;
                                        font-size:12px;
                                        font-weight:600;
                                    "
                                >

                                    <%= course.contentFiles.length %>
                                    files

                                </span>

                            </div>


                            <div
                                style="
                                    max-height:220px;
                                    overflow-y:auto;
                                    background:white;
                                    border:1px solid #e2e8f0;
                                    border-radius:8px;
                                    padding:10px;
                                "
                            >

                                <ul
                                    style="
                                        margin:0;
                                        padding-left:20px;
                                    "
                                >

                                    <% course.contentFiles.forEach(
                                        (file, index) => {
                                    %>

                                        <li
                                            style="
                                                margin:7px 0;
                                                color:#334155;
                                                font-size:13px;
                                            "
                                        >

                                            <strong>
                                                <%= index + 1 %>.
                                            </strong>

                                            <%= file.originalName || file.filename %>

                                        </li>

                                    <% }) %>

                                </ul>

                            </div>

                        </div>


                    <% } else { %>


                        <div
                            style="
                                margin-bottom:15px;
                                padding:18px;
                                background:#fff7ed;
                                border:1px solid #fed7aa;
                                border-radius:10px;
                                color:#9a3412;
                            "
                        >

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            No course material uploaded yet.

                        </div>


                    <% } %>


                    <!-- NEW FOLDER -->

                    <input
                        type="file"
                        id="contentFolder"
                        name="content"
                        webkitdirectory
                        directory
                        multiple
                    >


                    <small
                        class="upload-note"
                        style="
                            display:block;
                            margin-top:10px;
                            color:#64748b;
                            line-height:1.6;
                        "
                    >

                        Select a new course folder only if you want to
                        replace the existing course material.

                        <br>

                        The selected folder can contain:

                        PDF, MP4, WEBM, MOV, AVI, MKV,
                        DOC, DOCX, PPT, PPTX, TXT, ZIP and RAR files.

                        <br>

                        Maximum supported upload size:
                        <strong>3 GB+ folder upload</strong>.

                        <br>

                        Existing course material will be replaced by
                        the newly selected folder.

                    </small>


                    <!-- FOLDER PREVIEW -->

                    <div
                        id="folderPreview"
                        class="folder-preview"
                        style="
                            display:none;
                            margin-top:15px;
                            padding:15px;
                            background:#f8fafc;
                            border:1px solid #e2e8f0;
                            border-radius:10px;
                            max-height:260px;
                            overflow-y:auto;
                        "
                    >

                    </div>


                </div>


                <!-- ==========================================
                     UPDATE BUTTON
                =========================================== -->

                <button
                    type="submit"
                    class="save-btn"
                >

                    <i class="fa-solid fa-save"></i>

                    Update Course

                </button>


            </form>


        </div>


    </div>


</div>


<script nonce="<%= cspNonce %>">

    // ==========================================
    // FOLDER PREVIEW
    // ==========================================

    const folderInput =
        document.getElementById(
            "contentFolder"
        );

    const folderPreview =
        document.getElementById(
            "folderPreview"
        );


    if (folderInput && folderPreview) {

        folderInput.addEventListener(
            "change",
            function () {

                folderPreview.innerHTML = "";


                if (this.files.length === 0) {

                    folderPreview.style.display =
                        "none";

                    return;

                }


                folderPreview.style.display =
                    "block";


                const heading =
                    document.createElement("p");


                heading.innerHTML =
                    "<strong>" +
                    "New Folder Selected: " +
                    this.files.length +
                    " files" +
                    "</strong>";


                folderPreview.appendChild(
                    heading
                );


                const list =
                    document.createElement("ul");


                list.style.marginTop =
                    "10px";

                list.style.paddingLeft =
                    "20px";


                Array.from(this.files).forEach(
                    function (file, index) {

                        const item =
                            document.createElement(
                                "li"
                            );


                        item.style.margin =
                            "6px 0";

                        item.style.fontSize =
                            "13px";

                        item.style.color =
                            "#334155";


                        item.textContent =
                            file.webkitRelativePath ||
                            file.name;


                        list.appendChild(
                            item
                        );

                    }
                );


                folderPreview.appendChild(
                    list
                );

            }
        );

    }

</script>


<%- include("../layouts/dashboardFooter") %>