<%
const currentPage = "login-activity";
%>

<%- include("../layouts/adminDashboardHeader") %>
<%- include("../partials/adminSidebar") %>

<div class="main-content login-activity-page">
    <div class="admin-page-header">
        <div>
            <h1>Login Activity</h1>
            <p>Review successful account logins from the last 30 days.</p>
        </div>
    </div>

    <div class="login-statistics">
        <div class="login-stat-card">
            <span>Total Page Visits</span>
            <strong><%= totalVisits %></strong>
        </div>
        <div class="login-stat-card">
            <span>Unique Visitors</span>
            <strong><%= uniqueVisitors %></strong>
        </div>
        <div class="login-stat-card">
            <span>Registrations</span>
                <strong><%= registrationCount %></strong>
        </div>
        <div class="login-stat-card">
            <span>Total Logins</span>
            <strong><%= totalLogins %></strong>
        </div>
        <div class="login-stat-card">
            <span>User Logins</span>
            <strong><%= userLogins %></strong>
        </div>
        <div class="login-stat-card">
            <span>Admin Logins</span>
            <strong><%= adminLogins %></strong>
        </div>
        <div class="login-stat-card">
            <span>Recent Logins</span>
            <strong><%= recentLogins.length %></strong>
        </div>
    </div>

    <section class="login-panel">
        <div class="login-panel-header">
            <div>
                <h2>Filter Login Details</h2>
                <p>Results are limited to 200 records per search.</p>
            </div>
        </div>

        <form class="login-filters" method="GET" action="/admin/login-activity">
            <label>
                Search
                <input
                    type="search"
                    name="search"
                    value="<%= filters.search %>"
                    placeholder="Email or IP address">
            </label>

            <label>
                Role
                <select name="role">
                    <option value="all" <%= filters.role === "all" ? "selected" : "" %>>All roles</option>
                    <option value="user" <%= filters.role === "user" ? "selected" : "" %>>Users</option>
                    <option value="admin" <%= filters.role === "admin" ? "selected" : "" %>>Admins</option>
                </select>
            </label>

            <label>
                From
                <input type="date" name="from" value="<%= filters.from %>">
            </label>

            <label>
                To
                <input type="date" name="to" value="<%= filters.to %>">
            </label>

            <button type="submit" class="login-filter-button">
                <i class="fa-solid fa-filter"></i>
                Filter
            </button>

            <a href="/admin/login-activity" class="login-clear-button">Clear</a>
        </form>
    </section>

    <section class="login-panel">
        <div class="login-panel-header">
            <div>
                <h2>Login Details</h2>
                <p><%= activities.length %> record(s) shown. Page <%= loginPage %> of <%= loginPageCount %>.</p>
            </div>
        </div>
        <% if (loginPageCount > 1) { %>
            <div class="activity-pagination">
                <% if (loginPage > 1) { %>
                    <a href="/admin/login-activity?<%= new URLSearchParams({ ...filters, page: loginPage - 1 }).toString() %>">Previous</a>
                <% } %>
                <span>Page <%= loginPage %> of <%= loginPageCount %></span>
                <% if (loginPage < loginPageCount) { %>
                    <a href="/admin/login-activity?<%= new URLSearchParams({ ...filters, page: loginPage + 1 }).toString() %>">Next</a>
                <% } %>
            </div>
        <% } %>

        <div class="login-table-wrapper">
            <table class="login-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>IP Address</th>
                        <th>Device</th>
                        <th>Logged In</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (activities.length === 0) { %>
                        <tr>
                            <td colspan="6" class="login-empty">No login activity found.</td>
                        </tr>
                    <% } %>
                    <% activities.forEach(activity => { %>
                        <tr>
                            <td>
                                <strong>
                                    <%= activity.user ? `${activity.user.firstName} ${activity.user.lastName}` : "Deleted user" %>
                                </strong>
                            </td>
                            <td><%= activity.email %></td>
                            <td><span class="login-role <%= activity.role %>"><%= activity.role %></span></td>
                            <td><%= activity.ipAddress %></td>
                            <td class="login-user-agent" title="<%= activity.userAgent %>"><%= activity.userAgent %></td>
                            <td><%= formatPakistanDateTime(activity.loggedInAt) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-panel-header">
            <div>
                <h2>Visitor Details</h2>
                <p>Visitor records are available from the Visitors page.</p>
            </div>
        </div>

        <div class="login-panel-header">
            <a class="login-clear-button" href="/admin/visitors">Open Visitors</a>
        </div>
    </section>
</div>
