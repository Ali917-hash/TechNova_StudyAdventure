<% const currentPage = "visitors"; %>
<%- include("../layouts/adminDashboardHeader") %>
<%- include("../partials/adminSidebar") %>

<div class="main-content login-activity-page">
    <div class="admin-page-header">
        <div>
            <h1>Visitors</h1>
            <p>Review public page visits. Anonymous visitors cannot be identified by name.</p>
        </div>
    </div>

    <div class="login-statistics">
        <div class="login-stat-card"><span>Total Visits</span><strong><%= totalVisitors %></strong></div>
        <div class="login-stat-card"><span>Unique Visitors</span><strong><%= uniqueVisitors %></strong></div>
        <div class="login-stat-card"><span>Page</span><strong><%= page %> / <%= pageCount %></strong></div>
    </div>

    <section class="login-panel">
        <form class="login-filters" method="GET" action="/admin/visitors">
            <label>Search<input type="search" name="search" value="<%= filters.search %>" placeholder="Name, IP, browser, device, or page"></label>
            <label>From<input type="date" name="from" value="<%= filters.from %>"></label>
            <label>To<input type="date" name="to" value="<%= filters.to %>"></label>
            <button type="submit" class="login-filter-button"><i class="fa-solid fa-filter"></i> Filter</button>
            <a href="/admin/visitors" class="login-clear-button">Clear</a>
        </form>
    </section>

    <section class="login-panel">
        <div class="login-panel-header">
            <div><h2>Visitor Details</h2><p><%= visitors.length %> record(s) shown.</p></div>
        </div>
        <div class="login-table-wrapper">
            <table class="login-table">
                <thead><tr><th>Visitor</th><th>Device</th><th>Browser / OS</th><th>IP Address</th><th>Page</th><th>Visited</th></tr></thead>
                <tbody>
                    <% if (visitors.length === 0) { %><tr><td colspan="6" class="login-empty">No visitor activity found.</td></tr><% } %>
                    <% visitors.forEach(visitor => { %>
                        <tr>
                            <td><strong><%= visitor.user ? `${visitor.user.firstName} ${visitor.user.lastName}` : "Anonymous visitor" %></strong><% if (visitor.user?.email) { %><small><%= visitor.user.email %></small><% } %></td>
                            <td><%= visitor.deviceName %></td>
                            <td><%= visitor.browser %><br><small><%= visitor.operatingSystem %></small></td>
                            <td><%= visitor.ipAddress %></td><td><%= visitor.path %></td><td><%= formatPakistanDateTime(visitor.visitedAt) %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% if (pageCount > 1) { %>
            <div class="activity-pagination">
                <% if (page > 1) { %><a href="/admin/visitors?<%= new URLSearchParams({ ...filters, page: page - 1 }).toString() %>">Previous</a><% } %>
                <span>Page <%= page %> of <%= pageCount %></span>
                <% if (page < pageCount) { %><a href="/admin/visitors?<%= new URLSearchParams({ ...filters, page: page + 1 }).toString() %>">Next</a><% } %>
            </div>
        <% } %>
    </section>
</div>