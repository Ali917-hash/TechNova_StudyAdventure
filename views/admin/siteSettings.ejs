<!-- =====================================================
     HERO PAGE SWITCHING
===================================================== -->

<script nonce="<%= cspNonce %>">

const heroData = JSON.stringify({
    home: homeHero,
    about: aboutHero,
    services: servicesHero,
    portfolio: portfolioHero,
    blog: blogHero,
    contact: contactHero
});


const heroPageSelect = document.getElementById("heroPage");
const heroBadge = document.querySelector('[name="heroBadge"]');
const heroTitle = document.querySelector('[name="heroTitle"]');
const heroHighlight = document.querySelector('[name="heroHighlight"]');
const heroDescription = document.querySelector('[name="heroDescription"]');
const heroButtonText = document.querySelector('[name="heroButtonText"]');


const heroButtonLink =
    document.querySelector(
        '[name="heroButtonLink"]'
    );


const heroEnabled =
    document.querySelector(
        '[name="heroEnabled"]'
    );


const heroPreview =
    document.querySelector(
        ".settings-image-preview"
    );


function loadHero(
    page
) {

    const hero =
        heroData[page] || {};


    heroBadge.value =
        hero.badge || "";


    heroTitle.value =
        hero.title || "";


    heroHighlight.value =
        hero.highlight || "";


    heroDescription.value =
        hero.description || "";


    heroButtonText.value =
        hero.buttonText ||
        "Get Started";


    heroButtonLink.value =
        hero.buttonLink ||
        "/registration";


    heroEnabled.value =
        hero.enabled === false
            ? "false"
            : "true";


    if (hero.image) {

        heroPreview.innerHTML = `

            <img
                src="/uploads/${hero.image}"
                alt="${page} Hero"
            >

        `;

    } else {

        heroPreview.innerHTML = `

            <div class="no-image">
                No hero image uploaded.
            </div>

        `;

    }

}


heroPageSelect.addEventListener(
    "change",
    function () {

        loadHero(
            this.value
        );

    }
);


loadHero("home");

</script>


