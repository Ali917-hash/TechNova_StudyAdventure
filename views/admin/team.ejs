<%
const currentPage = "team";
%>

<%- include("../layouts/adminDashboardHeader") %>

<%- include("../partials/adminSidebar") %>


<div class="main-content">


    <div class="admin-page-header">

        <div>

            <h1>
                Leadership Team
            </h1>

            <p>
                Manage the team members displayed on the About page.
            </p>

        </div>


        <a
            href="/admin/team/add"
            class="save-btn"
        >

            <i class="fa-solid fa-plus"></i>

            Add Team Member

        </a>

    </div>



    <!-- ==========================================
         STATISTICS
    =========================================== -->

    <div class="cards">


        <div class="card">

            <i class="fa-solid fa-users"></i>

            <h2>
                <%= totalMembers %>
            </h2>

            <p>
                Total Members
            </p>

        </div>


        <div class="card">

            <i class="fa-solid fa-circle-check"></i>

            <h2>
                <%= publishedMembers %>
            </h2>

            <p>
                Published
            </p>

        </div>


        <div class="card">

            <i class="fa-solid fa-eye-slash"></i>

            <h2>
                <%= hiddenMembers %>
            </h2>

            <p>
                Hidden
            </p>

        </div>

    </div>



    <!-- ==========================================
         TEAM LIST
    =========================================== -->

    <div class="messages-card">

        <div class="messages-card-header">

            <div>

                <h2>
                    Team Members
                </h2>

                <p>
                    Manage leadership information shown
                    on the public About page.
                </p>

            </div>

        </div>


        <% if (
            !teamMembers ||
            teamMembers.length === 0
        ) { %>


            <div class="empty-messages">

                <i class="fa-solid fa-users"></i>

                <h3>
                    No Team Members
                </h3>

                <p>
                    Add your first leadership team member.
                </p>

            </div>


        <% } else { %>


            <div class="table-wrapper">

                <table class="messages-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Member
                            </th>

                            <th>
                                Position
                            </th>

                            <th>
                                Experience
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Order
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <% teamMembers.forEach(
                            (member, index) => {
                        %>


                            <tr>


                                <td>
                                    <%= index + 1 %>
                                </td>


                                <td>

                                    <div class="sender-info">

                                        <div class="sender-avatar">

                                            <img
                                                src="<%= uploadUrl(member.image) %>"
                                                alt="<%= member.name %>"
                                                style="
                                                    width:100%;
                                                    height:100%;
                                                    object-fit:cover;
                                                    border-radius:50%;
                                                "
                                            >

                                        </div>


                                        <strong>
                                            <%= member.name %>
                                        </strong>

                                    </div>

                                </td>


                                <td>
                                    <%= member.title %>
                                </td>


                                <td>
                                    <%= member.experience || "—" %>
                                </td>


                                <td>

                                    <% if (
                                        member.isPublished
                                    ) { %>

                                        <span
                                            class="message-status replied"
                                        >

                                            <i
                                                class="fa-solid fa-circle-check"
                                            ></i>

                                            Published

                                        </span>

                                    <% } else { %>

                                        <span
                                            class="message-status waiting"
                                        >

                                            <i
                                                class="fa-solid fa-eye-slash"
                                            ></i>

                                            Hidden

                                        </span>

                                    <% } %>

                                </td>


                                <td>
                                    <%= member.order %>
                                </td>


                                <td>

                                    <div
                                        class="message-actions"
                                    >


                                        <a
                                            href="/admin/team/edit/<%= member._id %>"
                                            class="view-btn"
                                            title="Edit"
                                        >

                                            <i
                                                class="fa-solid fa-pen"
                                            ></i>

                                        </a>


                                        <form
                                            action="/admin/team/toggle/<%= member._id %>"
                                            method="POST"
                                            style="display:inline;"
                                        >
                                            <input
                                                type="hidden"
                                                name="_csrf"
                                                value="<%= csrfToken %>"
                                            >

                                            <button
                                                type="submit"
                                                class="view-btn"
                                                title="Toggle Visibility"
                                            >
                                                <i class="fa-solid fa-power-off"></i>
                                            </button>
                                        </form>


                                        <form
                                            action="/admin/team/delete/<%= member._id %>"
                                            method="POST"
                                            style="display:inline;"
                                            data-confirm="Are you sure you want to delete this team member?"
                                        >
                                            <input
                                                type="hidden"
                                                name="_csrf"
                                                value="<%= csrfToken %>"
                                            >

                                            <button
                                                type="submit"
                                                class="delete-btn"
                                                title="Delete"
                                            >
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>


                                    </div>

                                </td>


                            </tr>


                        <% }) %>


                    </tbody>

                </table>

            </div>


        <% } %>


    </div>

</div>


<%- include("../layouts/dashboardFooter") %>